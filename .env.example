# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Токен приложения Crypto Pay от @CryptoBot (Crypto Pay -> Create App)
CRYPTOPAY_TOKEN=12345:AA...

# true — использовать testnet (@CryptoTestnetBot), false — mainnet (@CryptoBot)
CRYPTOPAY_TESTNET=false

# ID администраторов через запятую (разрешают споры)
ADMIN_IDS=123456789

# Комиссия сервиса в процентах (удерживается с продавца при выплате)
COMMISSION_PERCENT=5

# Минимальная сумма сделки (в выбранной валюте)
MIN_AMOUNT=1

# Путь к файлу базы данных SQLite
DB_PATH=guarantor.db
